# Database
DATABASE_URL=postgresql://unibridge:password@localhost:5432/unibridge_dev
TEST_DATABASE_URL=postgresql://unibridge:password@localhost:5432/unibridge_test

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME=UniBridge GH
PROJECT_VERSION=0.1.0

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=unibridge-documents
S3_REGION=us-east-1

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (for future use)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# University Admin Settings
DEFAULT_UNIVERSITY_ADMIN_PASSWORD=change-this-password
